#!/usr/bin/env bash
# intent-overlay — install the governance overlay across hosts (Claude, Codex, OpenCode).
#
# Two planes (see overlay/adapters/*.md):
#   discovery  — canonical skill in the hub (~/.codex/skills) + symlinks into each host's skill root
#   always-on  — the INVARIANTS block injected into each host's global instructions (reversible)
#
# The intent is enforced by SDD itself: code work waits on an approved proposal, and each phase emits
# its Intent Gate / Clean Code Gate line. There is no hard PreToolUse gate and no freeze sentinel.
# We never write gentle-ai-owned files.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SRC="$SCRIPT_DIR/skill"
STD_SRC="$SCRIPT_DIR/../skills/clean-code-standards"
INVARIANTS_SRC="$SCRIPT_DIR/instructions/INVARIANTS.md"
SKILL="intent-overlay"
STD_SKILL="clean-code-standards"

START="<!-- intent-overlay:start -->"
END="<!-- intent-overlay:end -->"

hub() { printf '%s' "$HOME/.codex/skills"; }
canonical_of() { printf '%s' "$(hub)/$1"; } # canonical_of NAME

# Scanned skill roots that receive a discovery symlink — only if the root already exists.
link_roots() {
  printf '%s\n' \
    "$HOME/.claude/skills" \
    "$HOME/.agents/skills" \
    "$HOME/.pi/agent/skills" \
    "$HOME/.config/opencode/skills"
}

usage() {
  cat <<'USAGE'
Usage: intent-overlay <command>
  install      Install discovery + always-on into every present host.
  uninstall    Reverse install: remove instruction blocks, symlinks, and the canonical skill.
  doctor       Verify the canonical skill, the symlinks, and each host's always-on block.
USAGE
}

# --- text helpers (pure bash; no sed/awk) -------------------------------------------------------

file_has_line() { # file_has_line NEEDLE FILE
  local needle=$1 file=$2 line
  [ -f "$file" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    [ "$line" = "$needle" ] && return 0
  done <"$file"
  return 1
}

# Print the span START..END (inclusive) from a source file.
extract_block() { # extract_block FILE START END
  local file=$1 s=$2 e=$3 line inside=0
  while IFS= read -r line || [ -n "$line" ]; do
    [ "$line" = "$s" ] && inside=1
    if [ "$inside" -eq 1 ]; then printf '%s\n' "$line"; fi
    [ "$line" = "$e" ] && inside=0
  done <"$file"
}

# Append a marked block to FILE if its START marker is not already present. Creates parents.
inject_block() { # inject_block FILE START_MARKER BLOCK_TEXT
  local file=$1 marker=$2 block=$3
  mkdir -p "$(dirname "$file")"
  [ -f "$file" ] || : >"$file"
  if file_has_line "$marker" "$file"; then return 0; fi
  printf '\n%s\n' "$block" >>"$file"
}

# Remove the marked block (and one preceding blank line) from FILE, leaving the rest byte-identical.
remove_block() { # remove_block FILE START_MARKER END_MARKER
  local file=$1 s=$2 e=$3
  [ -f "$file" ] || return 0
  local -a lines=() out=()
  local line
  while IFS= read -r line || [ -n "$line" ]; do lines+=("$line"); done <"$file"
  local i n=${#lines[@]} start_idx=-1 end_idx=-1
  for ((i = 0; i < n; i++)); do
    [ "${lines[i]}" = "$s" ] && [ "$start_idx" -lt 0 ] && start_idx=$i
    [ "${lines[i]}" = "$e" ] && [ "$start_idx" -ge 0 ] && { end_idx=$i; break; }
  done
  if [ "$start_idx" -lt 0 ] || [ "$end_idx" -lt 0 ]; then return 0; fi
  if [ "$start_idx" -gt 0 ] && [ -z "${lines[start_idx - 1]}" ]; then start_idx=$((start_idx - 1)); fi
  for ((i = 0; i < n; i++)); do
    if [ "$i" -ge "$start_idx" ] && [ "$i" -le "$end_idx" ]; then continue; fi
    out+=("${lines[i]}")
  done
  : >"$file"
  for line in "${out[@]}"; do printf '%s\n' "$line" >>"$file"; done
}

# --- per-host wiring (always-on block only) -----------------------------------------------------

invariants_block() { extract_block "$INVARIANTS_SRC" "$START" "$END"; }

host_install() {
  local block; block="$(invariants_block)"
  [ -d "$HOME/.codex" ] && inject_block "$HOME/.codex/AGENTS.override.md" "$START" "$block"
  [ -d "$HOME/.claude" ] && inject_block "$HOME/.claude/CLAUDE.md" "$START" "$block"
  [ -d "$HOME/.config/opencode" ] && inject_block "$HOME/.config/opencode/AGENTS.md" "$START" "$block"
  return 0
}

host_uninstall() {
  remove_block "$HOME/.codex/AGENTS.override.md" "$START" "$END"
  remove_block "$HOME/.claude/CLAUDE.md" "$START" "$END"
  remove_block "$HOME/.config/opencode/AGENTS.md" "$START" "$END"
}

# --- skill helpers (discovery plane) ------------------------------------------------------------

install_skill() { # install_skill SRC NAME
  local src=$1 name=$2 canon root link
  [ -f "$src/SKILL.md" ] || { echo "error: skill source not found at $src" >&2; return 1; }
  canon="$(canonical_of "$name")"
  mkdir -p "$canon"
  cp -R "$src/." "$canon/"
  while IFS= read -r root; do
    [ -d "$root" ] || continue
    link="$root/$name"
    if [ -L "$link" ] && [ "$(readlink "$link")" = "$canon" ]; then continue; fi
    rm -rf "$link"
    ln -s "$canon" "$link"
  done < <(link_roots)
}

uninstall_skill() { # uninstall_skill NAME
  local name=$1 canon root link
  canon="$(canonical_of "$name")"
  while IFS= read -r root; do
    link="$root/$name"
    [ -L "$link" ] && rm -f "$link"
  done < <(link_roots)
  rm -rf "$canon"
}

doctor_skill() { # doctor_skill NAME — echoes checks, returns nonzero on any FAIL
  local name=$1 canon ok=0 root link
  canon="$(canonical_of "$name")"
  if [ -f "$canon/SKILL.md" ]; then echo "ok   - $name canonical present"; else echo "FAIL - $name canonical missing: $canon"; ok=1; fi
  if [ -f "$canon/SKILL.md" ] && file_has_line "## Compact Rules" "$canon/SKILL.md"; then
    echo "ok   - $name declares Compact Rules"; else echo "FAIL - $name missing Compact Rules"; ok=1; fi
  while IFS= read -r root; do
    [ -d "$root" ] || continue
    link="$root/$name"
    [ -L "$link" ] || continue
    if [ -e "$link" ] && [ "$(readlink "$link")" = "$canon" ]; then echo "ok   - symlink valid: $link"; else echo "FAIL - broken/wrong symlink: $link"; ok=1; fi
  done < <(link_roots)
  return $ok
}

# --- commands -----------------------------------------------------------------------------------

do_install() {
  install_skill "$SRC" "$SKILL"
  install_skill "$STD_SRC" "$STD_SKILL"
  host_install
  echo "intent-overlay + clean-code-standards installed (hub: $(hub))."
  echo "Indexing: run 'gentle-ai skill-registry refresh --force' in a project (or restart the session)."
}

do_uninstall() {
  host_uninstall
  uninstall_skill "$SKILL"
  uninstall_skill "$STD_SKILL"
  echo "intent-overlay + clean-code-standards removed."
}

do_doctor() {
  local ok=0
  doctor_skill "$SKILL" || ok=1
  doctor_skill "$STD_SKILL" || ok=1
  if [ -d "$HOME/.codex" ]; then
    file_has_line "$START" "$HOME/.codex/AGENTS.override.md" && echo "ok   - codex always-on block" || echo "warn - codex always-on block missing"
  fi
  if [ -d "$HOME/.claude" ]; then
    file_has_line "$START" "$HOME/.claude/CLAUDE.md" && echo "ok   - claude always-on block" || echo "warn - claude always-on block missing"
  fi
  if [ -d "$HOME/.config/opencode" ]; then
    file_has_line "$START" "$HOME/.config/opencode/AGENTS.md" && echo "ok   - opencode always-on block" || echo "warn - opencode always-on block missing"
  fi
  return $ok
}

main() {
  case "${1:-}" in
    install) do_install ;;
    uninstall) do_uninstall ;;
    doctor) do_doctor ;;
    ""|-h|--help) usage ;;
    *) usage; return 1 ;;
  esac
}

main "$@"
